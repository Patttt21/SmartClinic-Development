    // Confidential Nursing Assessments — Strictly Nurse + Doctor (Admin & Receptionist blocked!)
    match /nursing_assessments/{visitId} {
      allow get: if isVerifiedUser() && isValidId(visitId) && hasStaffRole(['nurse', 'doctor']);
