rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Core Hardened Primitives
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidBoundedUidList(arr) {
      return arr is list && arr.size() <= 30 && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= 128));
    }

    function isBootstrapOwner() {
      return isVerifiedUser() && request.auth.token.email.lower() == 'cervitopatrick0@gmail.com';
    }

    function emailToInviteId(email) {
      return email.lower().replace('@', '_at_').replace('[^a-z0-9_\\-]', '_');
    }

    function isAdmin() {
      return isVerifiedUser() && (
        isBootstrapOwner() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function hasStaffRole(allowedRoles) {
      return isVerifiedUser() &&
        exists(/databases/$(database)/documents/staff_accounts/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/staff_accounts/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/staff_accounts/$(request.auth.uid)).data.role in allowedRoles;
    }

    function isAnyActiveStaff() {
      return hasStaffRole(['receptionist', 'nurse', 'doctor', 'laboratory', 'pharmacist', 'admin']) || isAdmin();
    }

    // -------------------------------------------------------------------------
    // Validation Blueprints (Anti-Update-Gap)
    // -------------------------------------------------------------------------
    function isValidAdminMarker(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidClinicRoster(data) {
      return data.keys().hasAll([
          'bootstrappedAdminUid',
          'adminUids',
          'doctorUids',
          'nurseUids',
          'receptionistUids',
          'labUids',
          'pharmacistUids',
          'allStaffUids',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'bootstrappedAdminUid',
          'adminUids',
          'doctorUids',
          'nurseUids',
          'receptionistUids',
          'labUids',
          'pharmacistUids',
          'allStaffUids',
          'createdAt',
          'updatedAt'
        ]) &&
        data.bootstrappedAdminUid is string && data.bootstrappedAdminUid.size() <= 128 &&
        isValidBoundedUidList(data.adminUids) &&
        isValidBoundedUidList(data.doctorUids) &&
        isValidBoundedUidList(data.nurseUids) &&
        isValidBoundedUidList(data.receptionistUids) &&
        isValidBoundedUidList(data.labUids) &&
        isValidBoundedUidList(data.pharmacistUids) &&
        isValidBoundedUidList(data.allStaffUids) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStaffAccount(data) {
      return data.keys().hasAll([
          'uid',
          'email',
          'fullName',
          'role',
          'department',
          'specialty',
          'titleDisplay',
          'active',
          'mfaEnrolled',
          'mfaEncryptedSecret',
          'mfaRecoveryHashes',
          'authorizedViewerUids',
          'createdIso',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'email',
          'fullName',
          'role',
          'department',
          'specialty',
          'titleDisplay',
          'active',
          'mfaEnrolled',
          'mfaEncryptedSecret',
          'mfaRecoveryHashes',
          'authorizedViewerUids',
          'createdIso',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120 &&
        data.role in ['receptionist', 'nurse', 'doctor', 'laboratory', 'pharmacist', 'admin'] &&
        data.department is string && data.department.size() <= 80 &&
        data.specialty is string && data.specialty.size() <= 100 &&
        data.titleDisplay is string && data.titleDisplay.size() <= 100 &&
        data.active is bool &&
        data.mfaEnrolled is bool &&
        data.mfaEncryptedSecret is string && data.mfaEncryptedSecret.size() <= 512 &&
        data.mfaRecoveryHashes is list && data.mfaRecoveryHashes.size() <= 10 &&
        (data.mfaRecoveryHashes.size() == 0 || (data.mfaRecoveryHashes[0] is string && data.mfaRecoveryHashes[0].size() <= 128)) &&
        isValidBoundedUidList(data.authorizedViewerUids) &&
        data.createdIso is string && data.createdIso.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStaffInvitation(data) {
      return data.keys().hasAll([
          'id',
          'email',
          'fullName',
          'role',
          'department',
          'specialty',
          'titleDisplay',
          'status',
          'invitedByUid',
          'authorizedViewerUids',
          'createdIso',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'email',
          'fullName',
          'role',
          'department',
          'specialty',
          'titleDisplay',
          'status',
          'invitedByUid',
          'authorizedViewerUids',
          'createdIso',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120 &&
        data.role in ['receptionist', 'nurse', 'doctor', 'laboratory', 'pharmacist', 'admin'] &&
        data.department is string && data.department.size() <= 80 &&
        data.specialty is string && data.specialty.size() <= 100 &&
        data.titleDisplay is string && data.titleDisplay.size() <= 100 &&
        data.status in ['Pending Enrollment', 'Claimed', 'Revoked'] &&
        data.invitedByUid is string && data.invitedByUid.size() <= 128 &&
        isValidBoundedUidList(data.authorizedViewerUids) &&
        data.createdIso is string && data.createdIso.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPublicDoctor(data) {
      return data.keys().hasAll([
          'id',
          'doctorUid',
          'doctorName',
          'specialty',
          'workdays',
          'startTime',
          'endTime',
          'breakStart',
          'breakEnd',
          'consultationDurationMinutes',
          'slotCapacity',
          'qualifiedServiceIds',
          'active',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'doctorUid',
          'doctorName',
          'specialty',
          'workdays',
          'startTime',
          'endTime',
          'breakStart',
          'breakEnd',
          'consultationDurationMinutes',
          'slotCapacity',
          'qualifiedServiceIds',
          'active',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.doctorUid is string && data.doctorUid.size() <= 128 &&
        data.doctorName is string && data.doctorName.size() >= 1 && data.doctorName.size() <= 120 &&
        data.specialty is string && data.specialty.size() <= 100 &&
        data.workdays is list && data.workdays.size() <= 7 &&
        (data.workdays.size() == 0 || data.workdays[0] is number) &&
        data.startTime is string && data.startTime.size() <= 10 &&
        data.endTime is string && data.endTime.size() <= 10 &&
        data.breakStart is string && data.breakStart.size() <= 10 &&
        data.breakEnd is string && data.breakEnd.size() <= 10 &&
        data.consultationDurationMinutes is number && data.consultationDurationMinutes >= 10 && data.consultationDurationMinutes <= 180 &&
        data.slotCapacity is number && data.slotCapacity >= 1 && data.slotCapacity <= 10 &&
        data.qualifiedServiceIds is list && data.qualifiedServiceIds.size() <= 25 &&
        (data.qualifiedServiceIds.size() == 0 || (data.qualifiedServiceIds[0] is string && data.qualifiedServiceIds[0].size() <= 128)) &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidClinicService(data) {
      return data.keys().hasAll([
          'id',
          'code',
          'name',
          'category',
          'description',
          'durationMinutes',
          'baseFeePhp',
          'directlyBookable',
          'active',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'code',
          'name',
          'category',
          'description',
          'durationMinutes',
          'baseFeePhp',
          'directlyBookable',
          'active',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.code is string && data.code.size() <= 40 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.category in ['Consultation', 'Follow-up', 'Laboratory'] &&
        data.description is string && data.description.size() <= 600 &&
        data.durationMinutes is number && data.durationMinutes >= 5 && data.durationMinutes <= 240 &&
        data.baseFeePhp is number && data.baseFeePhp >= 0 && data.baseFeePhp <= 100000 &&
        data.directlyBookable is bool &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPatientGuide(data) {
      return data.keys().hasAll([
          'id',
          'sectionKey',
          'sectionTitle',
          'topicTitle',
          'summary',
          'bulletPoints',
          'importantNotice',
          'lastUpdated',
          'updatedByName',
          'published',
          'sortOrder',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'sectionKey',
          'sectionTitle',
          'topicTitle',
          'summary',
          'bulletPoints',
          'importantNotice',
          'lastUpdated',
          'updatedByName',
          'published',
          'sortOrder',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.sectionKey in ['hmo', 'philhealth', 'privacy', 'clinic_guides'] &&
        data.sectionTitle is string && data.sectionTitle.size() <= 120 &&
        data.topicTitle is string && data.topicTitle.size() >= 1 && data.topicTitle.size() <= 160 &&
        data.summary is string && data.summary.size() <= 1500 &&
        data.bulletPoints is list && data.bulletPoints.size() <= 20 &&
        (data.bulletPoints.size() == 0 || (data.bulletPoints[0] is string && data.bulletPoints[0].size() <= 400)) &&
        data.importantNotice is string && data.importantNotice.size() <= 600 &&
        data.lastUpdated is string && data.lastUpdated.size() <= 40 &&
        data.updatedByName is string && data.updatedByName.size() <= 120 &&
        data.published is bool &&
        data.sortOrder is number &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPatientAccount(data) {
      return data.keys().hasAll([
          'uid',
          'email',
          'fullName',
          'phone',
          'dateOfBirth',
          'sex',
          'linkedPatientId',
          'optionalMfaEnabled',
          'optionalMfaEncryptedSecret',
          'createdIso',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'email',
          'fullName',
          'phone',
          'dateOfBirth',
          'sex',
          'linkedPatientId',
          'optionalMfaEnabled',
          'optionalMfaEncryptedSecret',
          'createdIso',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() <= 160 &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120 &&
        data.phone is string && data.phone.size() <= 40 &&
        data.dateOfBirth is string && data.dateOfBirth.size() <= 20 &&
        data.sex in ['Female', 'Male', 'Other', 'Prefer not to say'] &&
        data.linkedPatientId is string && data.linkedPatientId.size() <= 64 &&
        data.optionalMfaEnabled is bool &&
        data.optionalMfaEncryptedSecret is string && data.optionalMfaEncryptedSecret.size() <= 512 &&
        data.createdIso is string && data.createdIso.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidClinicalPatient(data) {
      return data.keys().hasAll([
          'patientId',
          'portalUserId',
          'fullName',
          'dateOfBirth',
          'sex',
          'phone',
          'email',
          'address',
          'allergies',
          'chronicConditions',
          'registrationSource',
          'authorizedViewerUids',
          'createdIso',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'patientId',
          'portalUserId',
          'fullName',
          'dateOfBirth',
          'sex',
          'phone',
          'email',
          'address',
          'allergies',
          'chronicConditions',
          'registrationSource',
          'authorizedViewerUids',
          'createdIso',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.patientId) &&
        data.portalUserId is string && data.portalUserId.size() <= 128 &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120 &&
        data.dateOfBirth is string && data.dateOfBirth.size() <= 20 &&
        data.sex in ['Female', 'Male', 'Other', 'Prefer not to say'] &&
        data.phone is string && data.phone.size() <= 40 &&
        data.email is string && data.email.size() <= 160 &&
        data.address is string && data.address.size() <= 300 &&
        data.allergies is string && data.allergies.size() <= 500 &&
        data.chronicConditions is string && data.chronicConditions.size() <= 500 &&
        data.registrationSource in ['Online Portal', 'Walk-in Front Desk'] &&
        isValidBoundedUidList(data.authorizedViewerUids) &&
        data.createdIso is string && data.createdIso.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBookedSlot(data) {
      return data.keys().hasAll([
          'id',
          'doctorUid',
          'appointmentDate',
          'appointmentTime',
          'endTime',
          'durationMinutes',
          'appointmentId',
          'portalUserId',
          'active',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'doctorUid',
          'appointmentDate',
          'appointmentTime',
          'endTime',
          'durationMinutes',
          'appointmentId',
          'portalUserId',
          'active',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.doctorUid is string && data.doctorUid.size() <= 128 &&
        data.appointmentDate is string && data.appointmentDate.size() <= 16 &&
        data.appointmentTime is string && data.appointmentTime.size() <= 10 &&
        data.endTime is string && data.endTime.size() <= 10 &&
        data.durationMinutes is number && data.durationMinutes >= 5 && data.durationMinutes <= 240 &&
        data.appointmentId is string && data.appointmentId.size() <= 128 &&
        data.portalUserId is string && data.portalUserId.size() <= 128 &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAppointment(data) {
      return data.keys().hasAll([
          'id',
          'referenceNumber',
          'patientId',
          'portalUserId',
          'patientName',
          'serviceId',
          'serviceName',
          'bookingMode',
          'doctorUid',
          'doctorName',
          'appointmentDate',
          'appointmentTime',
          'endTime',
          'durationMinutes',
          'status',
          'qrToken',
          'qrStatus',
          'blockedReplacementDates',
          'minReplacementDate',
          'previousAppointmentId',
          'followUpRecommendationId',
          'reasonForVisit',
          'checkedInAt',
          'visitId',
          'statusHistory',
          'authorizedViewerUids',
          'createdIso',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'referenceNumber',
          'patientId',
          'portalUserId',
          'patientName',
          'serviceId',
          'serviceName',
          'bookingMode',
          'doctorUid',
          'doctorName',
          'appointmentDate',
          'appointmentTime',
          'endTime',
          'durationMinutes',
          'status',
          'qrToken',
          'qrStatus',
          'blockedReplacementDates',
          'minReplacementDate',
          'previousAppointmentId',
          'followUpRecommendationId',
          'reasonForVisit',
          'checkedInAt',
          'visitId',
          'statusHistory',
          'authorizedViewerUids',
          'createdIso',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.referenceNumber is string && data.referenceNumber.size() <= 64 &&
        data.patientId is string && data.patientId.size() <= 64 &&
        data.portalUserId is string && data.portalUserId.size() <= 128 &&
        data.patientName is string && data.patientName.size() <= 120 &&
        data.serviceId is string && data.serviceId.size() <= 128 &&
        data.serviceName is string && data.serviceName.size() <= 120 &&
        data.bookingMode in ['Specific Doctor', 'Any Available Doctor'] &&
        data.doctorUid is string && data.doctorUid.size() <= 128 &&
        data.doctorName is string && data.doctorName.size() <= 120 &&
        data.appointmentDate is string && data.appointmentDate.size() <= 16 &&
        data.appointmentTime is string && data.appointmentTime.size() <= 10 &&
        data.endTime is string && data.endTime.size() <= 10 &&
        data.durationMinutes is number && data.durationMinutes >= 5 && data.durationMinutes <= 240 &&
        data.status in ['Confirmed', 'Checked In', 'Completed', 'Cancelled', 'Rescheduled', 'Needs Clinic Reschedule', 'No Show'] &&
        data.qrToken is string && data.qrToken.size() <= 300 &&
        data.qrStatus in ['Active', 'Used', 'Invalidated', 'Replaced'] &&
        data.blockedReplacementDates is list && data.blockedReplacementDates.size() <= 20 &&
        (data.blockedReplacementDates.size() == 0 || (data.blockedReplacementDates[0] is string && data.blockedReplacementDates[0].size() <= 16)) &&
        data.minReplacementDate is string && data.minReplacementDate.size() <= 16 &&
        data.previousAppointmentId is string && data.previousAppointmentId.size() <= 128 &&
        data.followUpRecommendationId is string && data.followUpRecommendationId.size() <= 128 &&
        data.reasonForVisit is string && data.reasonForVisit.size() <= 500 &&
        data.checkedInAt is string && data.checkedInAt.size() <= 40 &&
        data.visitId is string && data.visitId.size() <= 64 &&
        data.statusHistory is list && data.statusHistory.size() <= 25 &&
        isValidBoundedUidList(data.authorizedViewerUids) &&
        data.createdIso is string && data.createdIso.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidVisitEncounter(data) {
      return data.keys().hasAll([
          'id',
          'visitId',
          'queueNumber',
          'patientId',
          'portalUserId',
          'patientName',
          'appointmentId',
          'appointmentType',
          'serviceName',
          'doctorUid',
          'doctorName',
          'scheduledTime',
          'arrivalTime',
          'visitDate',
          'queueStatus',
          'clinicalPriority',
          'triageReferralNote',
          'checkedOutAt',
          'authorizedViewerUids',
          'createdIso',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'visitId',
          'queueNumber',
          'patientId',
          'portalUserId',
          'patientName',
          'appointmentId',
          'appointmentType',
          'serviceName',
          'doctorUid',
          'doctorName',
          'scheduledTime',
          'arrivalTime',
          'visitDate',
          'queueStatus',
          'clinicalPriority',
          'triageReferralNote',
          'checkedOutAt',
          'authorizedViewerUids',
          'createdIso',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.visitId is string && data.visitId.size() <= 64 &&
        data.queueNumber is string && data.queueNumber.size() <= 24 &&
        data.patientId is string && data.patientId.size() <= 64 &&
        data.portalUserId is string && data.portalUserId.size() <= 128 &&
        data.patientName is string && data.patientName.size() <= 120 &&
        data.appointmentId is string && data.appointmentId.size() <= 128 &&
        data.appointmentType in ['Online', 'Walk-in'] &&
        data.serviceName is string && data.serviceName.size() <= 120 &&
        data.doctorUid is string && data.doctorUid.size() <= 128 &&
        data.doctorName is string && data.doctorName.size() <= 120 &&
        data.scheduledTime is string && data.scheduledTime.size() <= 16 &&
        data.arrivalTime is string && data.arrivalTime.size() <= 40 &&
        data.visitDate is string && data.visitDate.size() <= 16 &&
        data.queueStatus in ['Checked In', 'Waiting for Nurse', 'In Assessment', 'Ready for Doctor', 'In Consultation', 'Consultation Completed', 'Checked Out'] &&
        data.clinicalPriority in ['Routine', 'Priority', 'Urgent Referral'] &&
        data.triageReferralNote is string && data.triageReferralNote.size() <= 500 &&
        data.checkedOutAt is string && data.checkedOutAt.size() <= 40 &&
        isValidBoundedUidList(data.authorizedViewerUids) &&
        data.createdIso is string && data.createdIso.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidNursingAssessment(data) {
      return data.keys().hasAll([
          'id', 'visitId', 'patientId', 'portalUserId',
          'bloodPressure', 'bodyTemperatureC', 'pulseRateBpm', 'respiratoryRateCpm', 'oxygenSaturationPct',
          'weightKg', 'heightCm', 'chiefComplaint', 'standardizedComplaint',
          'additionalSymptoms', 'symptomOnset', 'nursingObservations', 'clinicalPriority',
          'nurseUid', 'nurseName', 'completedAt', 'authorizedViewerUids', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'visitId', 'patientId', 'portalUserId',
          'bloodPressure', 'bodyTemperatureC', 'pulseRateBpm', 'respiratoryRateCpm', 'oxygenSaturationPct',
          'weightKg', 'heightCm', 'chiefComplaint', 'standardizedComplaint',
          'additionalSymptoms', 'symptomOnset', 'nursingObservations', 'clinicalPriority',
          'nurseUid', 'nurseName', 'completedAt', 'authorizedViewerUids', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.visitId is string && data.visitId.size() <= 64 &&
        data.patientId is string && data.patientId.size() <= 64 &&
        data.portalUserId is string && data.portalUserId.size() <= 128 &&
        data.bloodPressure is string && data.bloodPressure.size() <= 24 &&
        data.bodyTemperatureC is string && data.bodyTemperatureC.size() <= 16 &&
        data.pulseRateBpm is string && data.pulseRateBpm.size() <= 16 &&
        data.respiratoryRateCpm is string && data.respiratoryRateCpm.size() <= 16 &&
        data.oxygenSaturationPct is string && data.oxygenSaturationPct.size() <= 16 &&
        data.weightKg is string && data.weightKg.size() <= 16 &&
        data.heightCm is string && data.heightCm.size() <= 16 &&
        data.chiefComplaint is string && data.chiefComplaint.size() <= 500 &&
        data.standardizedComplaint in ['Fever', 'Cough', 'Headache', 'Stomach Pain', 'Other Complaints'] &&
        data.additionalSymptoms is string && data.additionalSymptoms.size() <= 600 &&
        data.symptomOnset is string && data.symptomOnset.size() <= 200 &&
        data.nursingObservations is string && data.nursingObservations.size() <= 1000 &&
        data.clinicalPriority in ['Routine', 'Priority', 'Urgent Referral'] &&
        data.nurseUid is string && data.nurseUid.size() <= 128 &&
        data.nurseName is string && data.nurseName.size() <= 120 &&
        data.completedAt is string && data.completedAt.size() <= 40 &&
        isValidBoundedUidList(data.authorizedViewerUids) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidConsultation(data) {
