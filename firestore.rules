        (data.hmoProvidersAcceptedForManualVerification.size() == 0 || (data.hmoProvidersAcceptedForManualVerification[0] is string && data.hmoProvidersAcceptedForManualVerification[0].size() <= 120)) &&
        data.philHealthAdvisoryNote is string && data.philHealthAdvisoryNote.size() <= 1000 &&
        data.requireLoaReferenceForHmo is bool &&
        data.defaultGeneralConsultationFeePhp is number && data.defaultGeneralConsultationFeePhp >= 0 &&
        data.defaultFollowUpConsultationFeePhp is number && data.defaultFollowUpConsultationFeePhp >= 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll([
          'id', 'actorUid', 'actorEmail', 'actorRole', 'action', 'category',
          'targetType', 'targetId', 'summary', 'authorizedViewerUids', 'createdIso', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'actorUid', 'actorEmail', 'actorRole', 'action', 'category',
          'targetType', 'targetId', 'summary', 'authorizedViewerUids', 'createdIso', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.actorUid == request.auth.uid &&
        data.actorEmail is string && data.actorEmail.size() <= 160 &&
        data.actorRole in ['patient', 'receptionist', 'nurse', 'doctor', 'laboratory', 'pharmacist', 'admin'] &&
        data.action is string && data.action.size() <= 120 &&
        data.category in ['Authentication', 'Clinical', 'Administrative', 'Security', 'Analytics'] &&
        data.targetType is string && data.targetType.size() <= 60 &&
        data.targetId is string && data.targetId.size() <= 128 &&
        data.summary is string && data.summary.size() <= 600 &&
        isValidBoundedUidList(data.authorizedViewerUids) &&
        data.createdIso is string && data.createdIso.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Match Blocks (Exhaustive Coverage)
    // -------------------------------------------------------------------------
    match /test/{docId} {
      allow get: if isValidId(docId);
      allow list, create, update, delete: if false;
    }

    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if false;
      allow create: if isVerifiedUser() &&
        isValidId(adminUid) &&
        isValidAdminMarker(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            adminUid == request.auth.uid &&
            isBootstrapOwner() &&
            !exists(/databases/$(database)/documents/clinic_roster/current)
          ) ||
          (
            adminUid == request.auth.uid &&
            exists(/databases/$(database)/documents/staff_invitations/$(emailToInviteId(request.auth.token.email))) &&
            get(/databases/$(database)/documents/staff_invitations/$(emailToInviteId(request.auth.token.email))).data.status == 'Pending Enrollment' &&
            get(/databases/$(database)/documents/staff_invitations/$(emailToInviteId(request.auth.token.email))).data.role == 'admin'
          )
        );
      allow update: if isVerifiedUser() &&
        isValidId(adminUid) &&
        isValidAdminMarker(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(adminUid) && !isBootstrapOwner();
    }

    match /clinic_roster/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if false;
      allow create: if isVerifiedUser() &&
        docId == 'current' &&
        isValidClinicRoster(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (isBootstrapOwner() && !exists(/databases/$(database)/documents/clinic_roster/current))
        );
      allow update: if isVerifiedUser() &&
        docId == 'current' &&
        isValidClinicRoster(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            isAnyActiveStaff() &&
            incoming().bootstrappedAdminUid == existing().bootstrappedAdminUid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'adminUids', 'doctorUids', 'nurseUids', 'receptionistUids', 'labUids', 'pharmacistUids', 'allStaffUids', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /staff_accounts/{staffUid} {
      allow get: if isSignedIn() && isValidId(staffUid) && (request.auth.uid == staffUid || isAdmin());
      allow list: if isSignedIn() && request.auth.uid in existing().authorizedViewerUids;
      allow create: if isVerifiedUser() &&
        isValidId(staffUid) &&
        isValidStaffAccount(incoming()) &&
        incoming().uid == staffUid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            staffUid == request.auth.uid &&
            incoming().role == 'admin' &&
            isBootstrapOwner() &&
            !exists(/databases/$(database)/documents/clinic_roster/current)
          ) ||
          (
            staffUid == request.auth.uid &&
            exists(/databases/$(database)/documents/staff_invitations/$(emailToInviteId(request.auth.token.email))) &&
            get(/databases/$(database)/documents/staff_invitations/$(emailToInviteId(request.auth.token.email))).data.status == 'Pending Enrollment' &&
            get(/databases/$(database)/documents/staff_invitations/$(emailToInviteId(request.auth.token.email))).data.role == incoming().role
          )
        );
      allow update: if isVerifiedUser() &&
        isValidId(staffUid) &&
        isValidStaffAccount(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            request.auth.uid == staffUid &&
            incoming().role == existing().role &&
            incoming().active == existing().active &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'mfaEnrolled', 'mfaEncryptedSecret', 'mfaRecoveryHashes', 'fullName', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /staff_invitations/{inviteId} {
      allow get: if isVerifiedUser() && isValidId(inviteId) && (
        isAdmin() ||
        existing().email == request.auth.token.email.lower()
      );
      allow list: if isSignedIn() && request.auth.uid in existing().authorizedViewerUids;
      allow create: if isVerifiedUser() &&
        isValidId(inviteId) &&
        isValidStaffInvitation(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
