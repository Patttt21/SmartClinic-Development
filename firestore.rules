    }

    match /follow_ups/{followUpId} {
      allow get: if isSignedIn() && isValidId(followUpId) && (
        existing().portalUserId == request.auth.uid ||
        hasStaffRole(['doctor', 'nurse', 'receptionist'])
      );
      allow list: if isSignedIn() && (
        existing().portalUserId == request.auth.uid ||
        request.auth.uid in existing().authorizedViewerUids
      );
      allow create: if isVerifiedUser() &&
        isValidId(followUpId) &&
        isValidFollowUp(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        hasStaffRole(['doctor']);
      allow update: if isVerifiedUser() &&
        isValidId(followUpId) &&
        isValidFollowUp(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          hasStaffRole(['doctor', 'receptionist']) ||
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['authorizedViewerUids', 'updatedAt'])
          ) ||
          (
            existing().portalUserId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'bookedAppointmentId', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /link_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (
        existing().portalUserId == request.auth.uid ||
        hasStaffRole(['receptionist', 'admin']) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().portalUserId == request.auth.uid ||
        request.auth.uid in existing().authorizedViewerUids
      );
      allow create: if isVerifiedUser() &&
        isValidId(requestId) &&
        isValidLinkRequest(incoming()) &&
        incoming().portalUserId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(requestId) &&
        isValidLinkRequest(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (hasStaffRole(['receptionist', 'admin']) || isAdmin()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'candidatePatientId', 'status', 'verificationNotes', 'reviewedByUid', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /leave_requests/{leaveId} {
      allow get: if isVerifiedUser() && isValidId(leaveId) && (
        existing().doctorUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().doctorUid == request.auth.uid ||
        request.auth.uid in existing().authorizedViewerUids
      );
      allow create: if isVerifiedUser() &&
        isValidId(leaveId) &&
        isValidLeaveRequest(incoming()) &&
        incoming().doctorUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        hasStaffRole(['doctor']);
      allow update: if isVerifiedUser() &&
        isValidId(leaveId) &&
        isValidLeaveRequest(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'reviewedByUid', 'reviewNotes', 'affectedAppointmentIds', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /approved_leaves/{leaveId} {
      allow get: if isSignedIn() && isValidId(leaveId);
      allow list: if isSignedIn() && existing().active == true;
      allow create: if isVerifiedUser() &&
        isValidId(leaveId) &&
        isValidApprovedLeave(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedUser() &&
        isValidId(leaveId) &&
        isValidApprovedLeave(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['active', 'startDate', 'endDate', 'updatedAt']);
      allow delete: if false;
    }

    match /notifications/{notifId} {
      allow get: if isSignedIn() && isValidId(notifId) && existing().recipientUid == request.auth.uid;
      allow list: if isSignedIn() && existing().recipientUid == request.auth.uid;
      allow create: if isVerifiedUser() &&
        isValidId(notifId) &&
        isValidNotification(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (incoming().recipientUid == request.auth.uid || isAnyActiveStaff());
      allow update: if isVerifiedUser() &&
        isValidId(notifId) &&
        isValidNotification(incoming()) &&
        incoming().id == existing().id &&
        incoming().recipientUid == existing().recipientUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        existing().recipientUid == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['read', 'popupDismissed', 'updatedAt']);
      allow delete: if false;
    }

    match /appointment_reminders/{reminderId} {
      allow get: if isSignedIn() && isValidId(reminderId) && (
        existing().portalUserId == request.auth.uid ||
        isAnyActiveStaff()
      );
      allow list: if isSignedIn() && (
        existing().portalUserId == request.auth.uid ||
        request.auth.uid in existing().authorizedViewerUids
      );
      allow create: if isVerifiedUser() &&
        isValidId(reminderId) &&
        isValidReminder(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (incoming().portalUserId == request.auth.uid || isAnyActiveStaff());
      allow update: if isVerifiedUser() &&
        isValidId(reminderId) &&
        isValidReminder(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (existing().portalUserId == request.auth.uid || isAnyActiveStaff()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'materializedAt', 'dueAtIso', 'appointmentDate', 'appointmentTime', 'updatedAt']);
      allow delete: if false;
    }

    match /evaluator_imports/{batchId} {
      allow get: if isAdmin() && isValidId(batchId);
      allow list: if isSignedIn() && request.auth.uid in existing().authorizedViewerUids;
      allow create: if isAdmin() &&
        isValidId(batchId) &&
        isValidEvaluatorImport(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(batchId);
    }

    match /evaluator_records/{recordId} {
      allow get: if isAdmin() && isValidId(recordId);
      allow list: if isSignedIn() && request.auth.uid in existing().authorizedViewerUids;
      allow create: if isAdmin() &&
        isValidId(recordId) &&
        isValidEvaluatorRecord(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(recordId);
    }

    match /operational_analytics_events/{visitId} {
      allow get: if isAdmin() && isValidId(visitId);
      allow list: if isSignedIn() && request.auth.uid in existing().authorizedViewerUids;
      allow create: if isVerifiedUser() &&
        isValidId(visitId) &&
        isValidOperationalAnalyticsEvent(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        hasStaffRole(['doctor']);
      allow update: if false;
      allow delete: if false;
    }

    match /coverage_settings/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if false;
      allow create: if isAdmin() &&
        docId == 'current' &&
        isValidCoverageSettings(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        docId == 'current' &&
        isValidCoverageSettings(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'hmoProvidersAcceptedForManualVerification', 'philHealthAdvisoryNote',
          'requireLoaReferenceForHmo', 'defaultGeneralConsultationFeePhp',
          'defaultFollowUpConsultationFeePhp', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /audit_logs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isSignedIn() && request.auth.uid in existing().authorizedViewerUids;
      allow create: if isVerifiedUser() &&
        isValidId(logId) &&
        isValidAuditLog(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if false;
      allow delete: if false;
    }
  }
}
