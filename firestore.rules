          'weightKg', 'heightCm', 'chiefComplaint', 'standardizedComplaint', 'additionalSymptoms',
          'symptomOnset', 'nursingObservations', 'clinicalPriority', 'completedAt', 'authorizedViewerUids', 'updatedAt'
        ]);
