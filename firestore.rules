    // Confidential Consultations — Strictly Doctor + Nurse + Patient (when Finalized). Admin & Receptionist blocked!
    match /consultations/{visitId} {
      allow get: if isSignedIn() && isValidId(visitId) && (
        hasStaffRole(['doctor', 'nurse']) ||
        (existing().patientVisible == true && existing().portalUserId == request.auth.uid)
      );
