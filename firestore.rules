        isValidVisitEncounter(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            existing().queueStatus != 'Checked Out' &&
            hasStaffRole(['receptionist', 'nurse', 'doctor']) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'queueStatus', 'clinicalPriority', 'triageReferralNote', 'doctorUid', 'doctorName',
              'checkedOutAt', 'authorizedViewerUids', 'updatedAt'
            ])
          )
