            existing().status in ['Confirmed', 'Needs Clinic Reschedule'] &&
            incoming().portalUserId == existing().portalUserId &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'qrStatus', 'qrToken', 'appointmentDate', 'appointmentTime', 'endTime',
              'doctorUid', 'doctorName', 'bookingMode', 'blockedReplacementDates',
