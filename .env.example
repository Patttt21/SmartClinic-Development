# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="http://localhost:3000"

# SMARTCLINIC_SERVER_SECRET: Server-only HMAC & AES-256-GCM secret used for TOTP encryption,
# MFA Assurance Level (AAL2) session tokens, and Appointment QR cryptographic signatures.
# Never expose this variable with a VITE_ prefix.
SMARTCLINIC_SERVER_SECRET="replace-with-32-byte-random-hex-secret-in-production"

# SMARTCLINIC_TIMEZONE: Clinic operational timezone for 24-hour reminders and schedules.
SMARTCLINIC_TIMEZONE="Asia/Manila"

# OPTIONAL EXTERNAL SUPABASE POSTGRESQL CONFIGURATION (For standalone GitHub/Vercel deployment)
# Note: In AI Studio Cloud Run, persistent database & authentication are provisioned via
# firebase-applet-config.json. To deploy against external Supabase PostgreSQL instead,
# run supabase/migrations/*.sql and configure the variables below:
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# GEMINI_API_KEY: Injected by AI Studio runtime if needed.
GEMINI_API_KEY=""
