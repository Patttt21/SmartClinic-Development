# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="http://localhost:3000"

# SMARTCLINIC_SERVER_SECRET: Server-only HMAC & AES-256-GCM secret used for TOTP encryption,
# MFA Assurance Level (AAL2) session tokens, and Appointment QR cryptographic signatures.
# Never expose this variable with a VITE_ prefix.
SMARTCLINIC_SERVER_SECRET="replace-with-32-byte-random-hex-secret-in-production"

# SMARTCLINIC_TIMEZONE: Clinic operational timezone for 24-hour reminders and schedules.
SMARTCLINIC_TIMEZONE="Asia/Manila"

# FIREBASE ADMIN SDK — ONE-TIME FIRST SYSTEM ADMINISTRATOR BOOTSTRAP (SERVER / CLI ONLY)
# Never expose any of these variables with a VITE_ prefix, in frontend code, or in chat.
# 1. FIREBASE_INITIAL_ADMIN_UID: Copy the exact User UID of your existing Google account from
#    Firebase Console -> Authentication -> Users.
# 2. Provide Firebase Admin credentials using ONE of the following server-only options:
#    - GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json" (recommended for local CLI)
#    - FIREBASE_SERVICE_ACCOUNT_JSON='{...}' (single-line JSON in Google AI Studio Secrets panel)
#    - FIREBASE_SERVICE_ACCOUNT_BASE64="..." (base64-encoded service account JSON in Secrets)
FIREBASE_INITIAL_ADMIN_UID=""
GOOGLE_APPLICATION_CREDENTIALS=""
FIREBASE_SERVICE_ACCOUNT_JSON=""
FIREBASE_SERVICE_ACCOUNT_BASE64=""

# OPTIONAL EXTERNAL SUPABASE VARIABLES (Leave blank when using Firebase Auth & Cloud Firestore)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_INITIAL_ADMIN_USER_ID=""

# GEMINI_API_KEY: Injected by AI Studio runtime if needed.
GEMINI_API_KEY=""
